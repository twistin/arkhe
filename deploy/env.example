# Copiar como /etc/arkhe/.env en el droplet, permiso 0600; nunca dentro del proyecto.
ARKHE_PUBLIC_HOST=arkhe.ejemplo.es
ARKHE_INSTANCE=arkhe-piloto
ARKHE_PRIVACY_EMAIL=responsable@ejemplo.es
ARKHE_PRIVACY_RESPONSIBLE=Responsable del piloto
ARKHE_DATA_REGION=Frankfurt
DOCENTE_AI_MISTRAL_API_KEY=
# Versiones del piloto; registrar los digests aprobados antes de publicar.
ARKHE_IMAGE=arkhe:piloto
